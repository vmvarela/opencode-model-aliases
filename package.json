{
  "name": "opencode-model-aliases",
  "version": "0.1.0",
  "description": "OpenCode plugin: materializes floating model aliases into the model catalog with strict/tolerant policies and latest-strategy selection.",
  "type": "module",
  "main": "./index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmvarela/opencode-model-aliases.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./tui.js"
    }
  },
  "files": [
    "index.js",
    "tui.js",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build && node --check scripts/smoke-opencode.mjs",
    "smoke:opencode": "node scripts/smoke-opencode.mjs",
    "smoke:inspect": "node scripts/smoke-opencode.mjs --inspect",
    "check:release": "node scripts/check-release.mjs"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "@opencode/plugin": "2.0.16",
    "@types/node": "^24.19.0",
    "@types/picomatch": "4.0.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.16"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "picomatch": "4.0.3"
  },
  "license": "MIT"
}
